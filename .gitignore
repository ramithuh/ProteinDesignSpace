# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Node / SvelteKit (for when the playground app lands here)
node_modules/
.svelte-kit/
build/
dist/
.vite/
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.wrangler/

# Local config / secrets
.env
.env.local
.env.*.local

# Large model artifacts — always go in per-bundle .gitignore too
*.onnx
*.onnx.data
*.bin
*.pt
*.ckpt

# Synced upstream WebGPU ES modules (recreated by `node tools/sync-upstream.mjs`)
# Compact JS/WGSL runtimes (no weights) are tracked so Cloudflare Pages builds
# work cleanly without private cross-repo auth; sharded weights are fetched from HuggingFace.
web/static/vendor/*
!web/static/vendor/genie3/
web/static/vendor/genie3/weights/
!web/static/vendor/thermompnn/
web/static/vendor/thermompnn/weights/
!web/static/vendor/ligandmpnn/
web/static/vendor/ligandmpnn/weights/
!web/static/vendor/lasermpnn/
web/static/vendor/lasermpnn/weights/
!web/static/vendor/antifold-esmif1/
web/static/vendor/antifold-esmif1/weights/
!web/static/vendor/protpardelle/
web/static/vendor/protpardelle/weights/
!web/static/vendor/esmc/
web/static/vendor/esmc/weights/
!web/static/vendor/dyna1/
web/static/vendor/dyna1/weights/
!web/static/vendor/rfdiffusion/
web/static/vendor/rfdiffusion/weights/
!web/static/vendor/rfd3/
web/static/vendor/rfd3/weights/
!web/static/vendor/boltzgen/
web/static/vendor/boltzgen/weights/
!web/static/vendor/evodiff/
web/static/vendor/evodiff/weights/
!web/static/vendor/la-proteina/
web/static/vendor/la-proteina/weights/
!web/static/vendor/proteina/
web/static/vendor/proteina/weights/
!web/static/vendor/genie2/
web/static/vendor/genie2/weights/
!web/static/vendor/frameflow/
web/static/vendor/frameflow/weights/
!web/static/vendor/foldflow2/
web/static/vendor/foldflow2/weights/
!web/static/vendor/sid-protein/
web/static/vendor/sid-protein/weights/
!web/static/vendor/gnina/
web/static/vendor/gnina/weights/
!web/static/vendor/pulchra/
# PULCHRA statistical tables (1.6 MB, packed by tools/pack-pulchra-tables.mjs) are source data, not weights.
!web/static/vendor/pulchra/pulchra-tables.bin
.upstream-tmp/
.promo-studio/
