# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Node / SvelteKit (for when the playground app lands here)
node_modules/
.svelte-kit/
build/
dist/
.vite/
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local config / secrets
.env
.env.local
.env.*.local

# Large model artifacts — always go in per-bundle .gitignore too
*.onnx
*.onnx.data
*.bin
*.pt
*.ckpt

# Synced upstream WebGPU ES modules (recreated by `node tools/sync-upstream.mjs`)
# Genie 3 JS/WGSL runtime (~220 KB, no weights) is tracked so Cloudflare Pages builds
# work without cross-repo private auth; its FP16 weights are fetched from HuggingFace.
web/static/vendor/*
!web/static/vendor/genie3/
web/static/vendor/genie3/weights/
.upstream-tmp/
